{
  "name": "@discovery/cassette-contract",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsup src/index.ts --format esm --clean",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist --rootDir src --composite false"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src/fixtures"
  ]
}
