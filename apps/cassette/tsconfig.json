{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "incremental": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    ".next-desktop-verify/types/**/*.ts",
    ".next-desktop/types/**/*.ts",
    ".next-pitch/types/**/*.ts",
    ".next-proto2/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "src",
    ".next-buildcheck/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
