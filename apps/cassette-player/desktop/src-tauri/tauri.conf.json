{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cassette",
  "version": "0.5.47",
  "identifier": "digital.cassette.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cassette",
        "width": 1200,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 28 },
        "backgroundColor": "#1c1914"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://www.cassette.digital/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3ODIzOTg0RTMyQ0I3MwpSV1J6eXpKT21DTjRENUZkN3N3Q2Q5bFhrNEsxbEh6MVBjT29nakswWXByY3JxdXJraWFCdTk1Zgo="
    }
  }
}
