# =============================================================================
# Cassette Player — Environment Variables
# Copy to .env.local for local development.
# GPL v3 fork of Navidrome — https://github.com/navidrome/navidrome
# =============================================================================

# -----------------------------------------------------------------------------
# Navidrome Core Configuration
# https://www.navidrome.org/docs/usage/configuration-options/
# -----------------------------------------------------------------------------

# Path inside the container where music files are read from.
# In Docker Compose this is mapped to ./music on the host.
ND_MUSICFOLDER=/music

# Path inside the container where Navidrome stores its database and cache.
# In Docker Compose this is mapped to ./data on the host.
ND_DATAFOLDER=/data

# How often Navidrome scans for new/changed music files.
# Accepts: @every <duration> | @hourly | @daily | @weekly | cron expression
ND_SCANNER_SCHEDULE=1h

# Log verbosity: trace | debug | info | warn | error
ND_LOGLEVEL=info

# How long a user session stays alive without activity.
ND_SESSIONTIMEOUT=24h

# Base URL if running behind a reverse proxy (e.g. https://player.cassette.digital)
# Leave empty for local dev.
ND_BASEURL=

# Port Navidrome listens on inside the container.
ND_PORT=4533

# Enable Spotify cover art lookup (optional)
# ND_SPOTIFY_ID=
# ND_SPOTIFY_SECRET=

# -----------------------------------------------------------------------------
# Cassette Player Admin — used by Cassette main app for auto-provisioning
# -----------------------------------------------------------------------------

# Admin credentials for the sidecar to call Navidrome's Subsonic API.
# Must match the account created during first-run at http://localhost:4533.
# The username is whatever you chose at first-run (common choices: admin, cassette).
NAVIDROME_ADMIN_USER=admin
NAVIDROME_ADMIN_PW=

# Admin credentials for API calls from apps/cassette.
# The Cassette backend uses these to create user accounts via Subsonic API
# when a customer makes their first purchase.
CASSETTE_PLAYER_ADMIN_USER=admin
CASSETTE_PLAYER_ADMIN_PASS=

# -----------------------------------------------------------------------------
# R2 Storage — future: for the R2 storage adapter (Go backend modification)
# These are not used yet. They're here for when we implement the adapter.
# -----------------------------------------------------------------------------

# Cloudflare account ID (find in R2 dashboard)
R2_ACCOUNT_ID=

# R2 API credentials (create in Cloudflare dashboard → R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The R2 bucket where purchased FLAC files live
R2_PLAYER_BUCKET=cassette-player-libraries

# R2 endpoint (auto-derived from account ID, but can be overridden)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# Host Hostname
# -----------------------------------------------------------------------------

# The Mac's mDNS hostname (e.g. my-mac.local), passed into the sidecar
# container so it registers a routable LAN address with cassette.digital instead
# of the Docker container ID.
# Set automatically by scripts/dev.sh — override here only if auto-detection
# (scutil --get LocalHostName) returns the wrong value.
HOST_HOSTNAME=

# -----------------------------------------------------------------------------
# Disc identification — gnudb + AcoustID (free, no Railway, run from the sidecar)
# -----------------------------------------------------------------------------

# AcoustID audio-fingerprint identification (the "Figure it out" scan). Free
# APPLICATION key — register at https://acoustid.org/new-application.
# If unset, the AcoustID rung is skipped cleanly (identification still works via
# disc ID / gnudb / MusicBrainz TOC / CD-TEXT / manual search). Only the audio
# fingerprint + duration ever leave the machine — never audio or file paths.
ACOUSTID_API_KEY=

# gnudb (the free CDDB/freedb successor) only honors a RECOGNIZED client name in
# its handshake — an unlisted name (incl. "cassette") is rejected "500 Unknown
# <name>". NOTE: gnudb's uniqcode registration (https://gnudb.org/info.php) does
# NOT whitelist a client name — it only gives you a host/email identity token.
# Getting "cassette" recognized is a SEPARATE step: email info@gnudb.org with the
# program name. Until then, set GNUDB_CLIENT_NAME to an already-recognized client
# (e.g. libcddb) or every lookup 500s.
# GNUDB_HOST: point at your registered uniqcode host (e.g. <uniqcode>.gnudb.org),
# which gnudb's registration asks for. Defaults to gnudb.gnudb.org. http/port 80.
GNUDB_HOST=gnudb.gnudb.org
GNUDB_CLIENT_NAME=libcddb
GNUDB_CONTACT_EMAIL=fork@cassette.digital

# -----------------------------------------------------------------------------
# Cassette Integration
# -----------------------------------------------------------------------------

# URL of the main Cassette Next.js app (for webhook callbacks, future use)
CASSETTE_API_URL=http://localhost:3100

# Internal shared secret for Cassette ↔ Cassette Player communication
# Generate with: openssl rand -hex 32
CASSETTE_INTERNAL_TOKEN=
